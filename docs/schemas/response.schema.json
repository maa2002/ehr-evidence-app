{
  "$defs": {
    "BundleRef": {
      "additionalProperties": false,
      "description": "The evidence bundle a response was built from.",
      "properties": {
        "bundle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "sha256"
      ],
      "title": "BundleRef",
      "type": "object"
    },
    "CaseRef": {
      "additionalProperties": false,
      "description": "One case of one case set, numbered from 1 in the closure record.",
      "properties": {
        "case_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Case Number",
          "type": "integer"
        },
        "case_set": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Case Set",
          "type": "string"
        }
      },
      "required": [
        "case_set",
        "case_number"
      ],
      "title": "CaseRef",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One factual statement and the evidence records that support it.",
      "properties": {
        "refs": {
          "items": {
            "pattern": "^[VEPAC][1-9][0-9]{0,5}$",
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Refs",
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ScopeRef": {
      "additionalProperties": false,
      "description": "An explicit record scope; only a selected visit names its visit.",
      "properties": {
        "kind": {
          "enum": [
            "pre_target_history",
            "selected_visit",
            "case_visits"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visit_number": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ScopeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exactly one outcome for one request.",
  "properties": {
    "bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/BundleRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case": {
      "$ref": "#/$defs/CaseRef"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "maxItems": 200,
      "title": "Claims",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "answer",
        "not_recorded",
        "explanation",
        "clarification",
        "abstention",
        "case_rejection",
        "validation_rejection",
        "operational_error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "enum": [
          "attribution_altered",
          "backend_failed",
          "batch_sensitive_prediction",
          "case_not_admitted",
          "claim_unsupported",
          "concept_ambiguous",
          "coverage_incomplete",
          "date_unsupported",
          "evidence_inconsistent",
          "evidence_insufficient",
          "explanation_ineligible",
          "history_inconsistent",
          "identity_inconsistent",
          "limit_exceeded",
          "no_positive_attribution",
          "prediction_altered",
          "prediction_link_invalid",
          "prohibited_wording",
          "reference_unresolved",
          "resource_exhausted",
          "retrieval_failed",
          "scope_ambiguous",
          "scope_invalid",
          "scope_violated",
          "structure_invalid",
          "target_attached_drivers_present",
          "target_outcome_entries_excluded",
          "task_ambiguous",
          "task_unsupported",
          "timeout",
          "unmapped_records_in_scope",
          "validator_failed",
          "visit_ambiguous"
        ],
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeRef"
    },
    "task": {
      "enum": [
        "condition_list",
        "condition_presence",
        "prediction_explanation"
      ],
      "title": "Task",
      "type": "string"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "task",
    "case",
    "scope",
    "outcome"
  ],
  "title": "Response",
  "type": "object"
}
