{
  "$defs": {
    "BundleRef": {
      "additionalProperties": false,
      "description": "The evidence bundle a response was built from.",
      "properties": {
        "bundle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "sha256"
      ],
      "title": "BundleRef",
      "type": "object"
    },
    "CaseRef": {
      "additionalProperties": false,
      "description": "One case of one case set, numbered from 1 in the closure record.",
      "properties": {
        "case_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Case Number",
          "type": "integer"
        },
        "case_set": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Case Set",
          "type": "string"
        }
      },
      "required": [
        "case_set",
        "case_number"
      ],
      "title": "CaseRef",
      "type": "object"
    },
    "ConditionName": {
      "additionalProperties": false,
      "description": "How a statement names a condition: by a recorded event, by\nvocabulary concepts or by an ICD code. The name shown is rendered from\nthe evidence or the vocabulary.",
      "properties": {
        "code": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "concepts": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "maxItems": 50,
          "title": "Concepts",
          "type": "array"
        },
        "event": {
          "anyOf": [
            {
              "pattern": "^E[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event"
        }
      },
      "title": "ConditionName",
      "type": "object"
    },
    "ItemCount": {
      "additionalProperties": false,
      "description": "A count of distinct items of one kind of record.",
      "properties": {
        "count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "condition",
            "procedure",
            "medication",
            "lab",
            "microbiology",
            "vital",
            "transfer",
            "icu_stay"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "count"
      ],
      "title": "ItemCount",
      "type": "object"
    },
    "ItemName": {
      "additionalProperties": false,
      "description": "How a statement about the record names what it is about: by a\nrecord of the bundle, or by the names a question's phrase resolved\nto (as the dictionary writes them).",
      "properties": {
        "record": {
          "anyOf": [
            {
              "pattern": "^R[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record"
        },
        "terms": {
          "default": [],
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Terms",
          "type": "array"
        }
      },
      "title": "ItemName",
      "type": "object"
    },
    "ScopeRef": {
      "additionalProperties": false,
      "description": "An explicit record scope; only a selected visit names its visit.",
      "properties": {
        "kind": {
          "enum": [
            "pre_target_history",
            "selected_visit",
            "case_visits"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visit_number": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ScopeRef",
      "type": "object"
    },
    "Slots": {
      "additionalProperties": false,
      "description": "The facts of one statement; its kind decides which it has.",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "count": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Count"
        },
        "driver": {
          "anyOf": [
            {
              "pattern": "^A[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Driver"
        },
        "earlier": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Earlier"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "sex",
                "age",
                "race",
                "language",
                "insurance",
                "marital_status",
                "death",
                "admitted",
                "discharged",
                "length",
                "type",
                "admitted_from",
                "discharged_to",
                "hospital_death",
                "summary"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "groups": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Groups"
        },
        "how": {
          "anyOf": [
            {
              "enum": [
                "item",
                "group",
                "ingredient",
                "class",
                "brand",
                "name",
                "words",
                "exact",
                "more_specific",
                "icd_code",
                "more_specific_icd_code",
                "icd_description"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "How"
        },
        "item": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/ItemCount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "condition",
                "procedure",
                "medication",
                "lab",
                "microbiology",
                "vital",
                "transfer",
                "icu_stay"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "label": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "labels": {
          "anyOf": [
            {
              "items": {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 20,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labels"
        },
        "logit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logit"
        },
        "match": {
          "anyOf": [
            {
              "enum": [
                "exact",
                "more_specific",
                "icd_code",
                "more_specific_icd_code",
                "icd_description"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match"
        },
        "matches": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matches"
        },
        "names": {
          "anyOf": [
            {
              "items": {
                "minimum": 1,
                "type": "integer"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Names"
        },
        "omitted": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omitted"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "condition",
                  "procedure",
                  "medication",
                  "lab",
                  "microbiology",
                  "vital",
                  "transfer",
                  "icu_stay"
                ],
                "type": "string"
              },
              "maxItems": 8,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "records": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Records"
        },
        "requested": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "selector": {
          "anyOf": [
            {
              "enum": [
                "latest",
                "first",
                "highest",
                "lowest",
                "only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selector"
        },
        "term": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term"
        },
        "total": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "unmapped": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unmapped"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^R[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "visit": {
          "anyOf": [
            {
              "pattern": "^V[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit"
        },
        "visits": {
          "anyOf": [
            {
              "items": {
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              "maxItems": 1000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visits"
        },
        "when": {
          "anyOf": [
            {
              "pattern": "^R[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "title": "Slots",
      "type": "object"
    },
    "Statement": {
      "additionalProperties": false,
      "description": "One statement: its kind, wording, facts and supporting references.\n\nA notice names its approved text; any other statement has no notice.",
      "properties": {
        "kind": {
          "enum": [
            "list_summary",
            "list_item",
            "list_unmapped",
            "list_empty",
            "presence_summary",
            "presence_item",
            "presence_absent",
            "presence_unmapped",
            "prediction",
            "driver",
            "driver_history",
            "driver_context",
            "record_list_summary",
            "record_list_item",
            "record_stay_item",
            "record_list_empty",
            "record_presence_summary",
            "record_presence_item",
            "record_absent",
            "record_unmapped",
            "record_time",
            "record_count",
            "record_count_kind",
            "record_value",
            "record_value_group",
            "record_value_item",
            "record_abnormal_summary",
            "record_abnormal_absent",
            "visit_summary",
            "visit_fact",
            "person_fact",
            "person_age",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notice": {
          "anyOf": [
            {
              "enum": [
                "absence",
                "list_complete",
                "coverage_incomplete",
                "unsupported_treatment",
                "unsupported_prognosis",
                "unsupported_diagnosis_request",
                "unsupported_other_data",
                "unsupported_time_or_count",
                "unsupported_ranking",
                "unsupported_count_list",
                "concept_ambiguous",
                "concept_suggested",
                "concept_unknown",
                "concept_missing",
                "concept_too_broad",
                "scope_other",
                "scope_several",
                "scope_unrecognised",
                "visit_missing",
                "case_other",
                "prediction_selection",
                "qualified",
                "unexplained",
                "two_conditions",
                "two_tasks",
                "not_understood",
                "drivers",
                "drivers_omitted",
                "attribution_meaning",
                "score_meaning",
                "batch_sensitive",
                "target_attached",
                "target_excluded",
                "explanation_ineligible",
                "no_positive_attribution",
                "explanation_incomplete",
                "record_list_complete",
                "values_omitted",
                "not_flagged",
                "vital_no_flag",
                "vitals_icu_only",
                "dates_shifted",
                "age_meaning",
                "death_meaning",
                "several_kinds",
                "item_suggested",
                "item_unknown",
                "item_missing",
                "item_too_broad",
                "two_items",
                "flag_unrecorded",
                "indication_unrecorded"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice"
        },
        "refs": {
          "default": [],
          "items": {
            "pattern": "^[VEPACRD][1-9][0-9]{0,5}$",
            "type": "string"
          },
          "maxItems": 5000,
          "title": "Refs",
          "type": "array"
        },
        "slots": {
          "$ref": "#/$defs/Slots",
          "default": {
            "condition": null,
            "count": null,
            "driver": null,
            "earlier": null,
            "field": null,
            "groups": null,
            "how": null,
            "item": null,
            "items": null,
            "kind": null,
            "label": null,
            "labels": null,
            "logit": null,
            "match": null,
            "matches": null,
            "names": null,
            "omitted": null,
            "options": null,
            "rank": null,
            "records": null,
            "requested": null,
            "scope": null,
            "score": null,
            "selector": null,
            "term": null,
            "total": null,
            "unmapped": null,
            "value": null,
            "visit": null,
            "visits": null,
            "when": null
          }
        },
        "wording": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "wording"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A candidate response to one request, before any check.",
  "properties": {
    "bundle": {
      "anyOf": [
        {
          "$ref": "#/$defs/BundleRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "case": {
      "$ref": "#/$defs/CaseRef"
    },
    "outcome": {
      "enum": [
        "answer",
        "not_recorded",
        "explanation",
        "clarification",
        "abstention",
        "case_rejection",
        "validation_rejection",
        "operational_error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reason_codes": {
      "default": [],
      "items": {
        "enum": [
          "attribution_altered",
          "backend_failed",
          "batch_sensitive_prediction",
          "case_ambiguous",
          "case_not_admitted",
          "claim_unsupported",
          "concept_ambiguous",
          "concept_too_broad",
          "concept_unknown",
          "coverage_incomplete",
          "date_unsupported",
          "evidence_inconsistent",
          "evidence_insufficient",
          "explanation_ineligible",
          "history_inconsistent",
          "identity_inconsistent",
          "limit_exceeded",
          "no_positive_attribution",
          "prediction_altered",
          "prediction_link_invalid",
          "prediction_selection_needed",
          "prohibited_wording",
          "reference_unresolved",
          "resource_exhausted",
          "retrieval_failed",
          "scope_ambiguous",
          "scope_invalid",
          "scope_violated",
          "structure_invalid",
          "target_attached_drivers_present",
          "target_outcome_entries_excluded",
          "task_ambiguous",
          "task_unsupported",
          "timeout",
          "unmapped_records_in_scope",
          "validator_failed",
          "visit_ambiguous"
        ],
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeRef"
    },
    "statements": {
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Statements",
      "type": "array"
    },
    "task": {
      "anyOf": [
        {
          "enum": [
            "condition_list",
            "condition_presence",
            "prediction_explanation",
            "record_list",
            "record_presence",
            "record_timing",
            "record_count",
            "record_values",
            "record_abnormal",
            "visit_details",
            "person_details"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "case",
    "scope",
    "outcome",
    "statements"
  ],
  "title": "Candidate",
  "type": "object"
}
