{
  "$defs": {
    "CaseRef": {
      "additionalProperties": false,
      "description": "One case of one case set, numbered from 1 in the closure record.",
      "properties": {
        "case_number": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Case Number",
          "type": "integer"
        },
        "case_set": {
          "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
          "title": "Case Set",
          "type": "string"
        }
      },
      "required": [
        "case_set",
        "case_number"
      ],
      "title": "CaseRef",
      "type": "object"
    },
    "PredictionRef": {
      "additionalProperties": false,
      "description": "The selected inherited prediction, by its output record digest.",
      "properties": {
        "output_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "output_record_sha256"
      ],
      "title": "PredictionRef",
      "type": "object"
    },
    "ScopeRef": {
      "additionalProperties": false,
      "description": "An explicit record scope; only a selected visit names its visit.",
      "properties": {
        "kind": {
          "enum": [
            "pre_target_history",
            "selected_visit",
            "case_visits"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visit_number": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit Number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ScopeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One task for one case in one explicit scope.",
  "properties": {
    "case": {
      "$ref": "#/$defs/CaseRef"
    },
    "prediction": {
      "anyOf": [
        {
          "$ref": "#/$defs/PredictionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeRef"
    },
    "task": {
      "enum": [
        "condition_list",
        "condition_presence",
        "prediction_explanation"
      ],
      "title": "Task",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "task",
    "case",
    "scope"
  ],
  "title": "Request",
  "type": "object"
}
