{
  "schema_version": "1.0",
  "step": "10",
  "purpose": "Publishable ClearML connection declaration read by ehr_evidence_app.tracking.connection. It records the user-authorised hosted endpoints, workspace and project, and names the process-local environment variable that points the SDK at the existing untracked configuration file. It holds no local path, account, key or configuration content.",
  "notes": [
    "Only this repository's config directory may supply this file.",
    "This declaration satisfies the Step 9 authorization gate (user_approved_step_10_configuration) for connection checks only; config/clearml_policy.json still governs which payload categories may ever reach the tracker.",
    "The configuration file stays at its existing untracked location and is named only through CLEARML_CONFIG_FILE in the probe process; its path is never recorded here.",
    "ADR 0018 enables named lineage tasks with allowlisted configuration fields and aggregate scalars, and the files of the listed pretrained models through tracking.models; nothing patient-bearing is enabled."
  ],
  "tracker": {
    "name": "clearml",
    "package": "clearml",
    "locked_version": "2.1.12"
  },
  "authorization": {
    "status": "user_authorized",
    "mode": "hosted_metadata_only",
    "remote_payloads": "metadata_only",
    "offline_fallback": false
  },
  "endpoints": {
    "web_server": "https://app.clear.ml",
    "api_server": "https://api.clear.ml",
    "files_server": "https://files.clear.ml"
  },
  "workspace": "Abdullah  Aamir's workspace",
  "project": "ehr-evidence-app",
  "configuration_file": {
    "environment_variable": "CLEARML_CONFIG_FILE",
    "scope": "process_local",
    "path_recorded": false,
    "contents_read_by_checker": false,
    "inside_repository_permitted": false,
    "override_variables_permitted": false
  },
  "payload_policy": {
    "policy_file": "config/clearml_policy.json",
    "remote_payloads": "metadata_only",
    "protected_records": "local_w_only"
  },
  "synthetic_task": {
    "task_name": "SYNTHETIC step-10 connection check",
    "task_type": "testing",
    "tags": ["synthetic", "step-10", "connection-check", "metadata-only"],
    "comment": "SYNTHETIC Step 10 connection check. Metadata only; no patient, protected, prompt, response, attribution, model or data content.",
    "max_tasks_per_run": 1,
    "archive_after_creation": true,
    "task_init_used": false,
    "auto_connect_frameworks": false,
    "auto_connect_arg_parser": false,
    "auto_connect_streams": false,
    "auto_resource_monitoring": false,
    "detect_repository": false,
    "capture_packages": false,
    "capture_environment": false,
    "upload_artifacts": false
  },
  "model_artefacts": {
    "status": "enabled_for_listed_models",
    "upload_in_step_10": false,
    "enablement_gate": "project_owner_decision_adr_0018",
    "hyperparameters": "controlled_configuration_allowlist",
    "listed_models": [
      "google/medgemma-1.5-4b-it"
    ],
    "files_and_revision": "config/generation.json",
    "requirements": {
      "policy_amendment": "adr_0018",
      "dedicated_staging_path": "workspace_outputs_model_staging",
      "artefact_manifest": "manifest_fields",
      "privacy_review": "pretrained_by_its_publisher_not_on_project_data",
      "explicit_enablement_gate": "tracking_models_operator_upload"
    },
    "licence": {
      "name": "health-ai-developer-foundations",
      "notice_file_required": true,
      "agreement_copy_required": true
    },
    "manifest_fields": [
      "logical_name",
      "type",
      "size_bytes",
      "sha256",
      "provenance",
      "non_patient_non_secret_confirmation"
    ],
    "always_excluded": [
      "data_files",
      "samples",
      "labels",
      "prompts",
      "patient_level_records",
      "optimizer_state",
      "cached_batches",
      "tokenizer_inputs",
      "debug_dumps",
      "traces",
      "arbitrary_training_directories",
      "automatic_environment_capture",
      "automatic_source_capture",
      "patient_derived_models",
      "gnn_checkpoints"
    ]
  }
}
