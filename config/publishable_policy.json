  "signatures": [
    {
      "id": "private_key_block",
      "category": "private_key",
      "pattern": "-{5}BEGIN(?: [A-Z0-9]+)* PRIVATE KEY(?: BLOCK)?-{5}",
      "exempt_placeholders": false
    },
    {
      "id": "putty_private_key",
      "category": "private_key",
      "pattern": "PuTTY-User-Key-File-[0-9]+:",
      "exempt_placeholders": false
    },
    {
      "id": "aws_access_key_id",
      "category": "token",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "exempt_placeholders": false
    },
    {
      "id": "github_token",
      "category": "token",
      "pattern": "\\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{22,})",
      "exempt_placeholders": false
    },
    {
      "id": "llm_provider_api_key",
      "category": "token",
      "pattern": "\\bsk-(?:ant-|proj-)?[A-Za-z0-9_-]{32,}",
      "exempt_placeholders": false
    },
    {
      "id": "huggingface_token",
      "category": "token",
      "pattern": "\\bhf_[A-Za-z0-9]{34,}\\b",
      "exempt_placeholders": false
    },
    {
      "id": "slack_token",
      "category": "token",
      "pattern": "\\bxox[abposr]-[A-Za-z0-9-]{10,}",
      "exempt_placeholders": false
    },
    {
      "id": "google_api_key",
      "category": "token",
      "pattern": "\\bAIza[0-9A-Za-z_-]{35}",
      "exempt_placeholders": false
    },
    {
      "id": "stripe_live_key",
      "category": "token",
      "pattern": "\\b[rs]k_live_[0-9A-Za-z]{16,}",
      "exempt_placeholders": false
    },
    {
      "id": "json_web_token",
      "category": "token",
      "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
      "exempt_placeholders": false
    },
    {
      "id": "credential_uri",
      "category": "credential_uri",
      "pattern": "\\b[A-Za-z][A-Za-z0-9+.-]{1,30}://[^\\s:/?#@\\x22\\x27\\x60]*:(?P<secret>[^\\s/?#@\\x22\\x27\\x60]+)@",
      "exempt_placeholders": true
    },
    {
      "id": "secret_assignment",
      "category": "secret_assignment",
      "pattern": "(?i)\\b[A-Za-z0-9_]*(?:password|passwd|passphrase|secret|api[_-]?key|access[_-]?key|auth[_-]?token|access[_-]?token|api[_-]?token|client[_-]?secret|private[_-]?key)[A-Za-z0-9_]*[\\x22\\x27]?[ \\t]*[:=][ \\t]*(?P<quote>[\\x22\\x27])(?P<secret>(?:(?!(?P=quote))[^\\r\\n]){8,})(?P=quote)",
      "exempt_placeholders": true
    },
    {
      "id": "unquoted_secret_assignment",
      "category": "unquoted_assignment",
      "pattern": "(?im)^[ \\t]*(?:-[ \\t]+)?(?:export[ \\t]+|set[ \\t]+|\\$env:)?[A-Za-z0-9_.-]*(?:password|passwd|passphrase|secret|token|api[_-]?key|access[_-]?key|secret[_-]?key|private[_-]?key|client[_-]?secret)[ \\t]*[:=][ \\t]*(?P<secret>[^\\s\\x22\\x27\\x60#;()\\[\\]{},<>$%*][^\\s\\x22\\x27\\x60()\\[\\]{},]{7,})[ \\t]*(?:[#;][^\\r\\n]*)?\\r?$",
      "exempt_placeholders": true
    }
  ],
  "user_path": {
    "id": "machine_user_path",
    "pattern": "(?i)\\b[A-Z]:(?:\\\\{1,2}|/)Users(?:\\\\{1,2}|/)(?P<account><[^<>\\r\\n]*>|[^\\\\/\\s<>\\x22\\x27\\x60]+)",
    "allowed_accounts": [
      "All",
      "Default",
      "Public"
    ]
  },
  "patient_identifier": {
    "id": "patient_identifier_assignment",
    "pattern": "(?i)(?:(?<![A-Za-z0-9_])(?:person_id|subject_id|hadm_id|patient_index)[\\x22\\x27]?\\s*[:=]\\s*[\\x22\\x27]?|--(?:person|subject|hadm)[_-]id[ =][\\x22\\x27]?|--patient[_-]index[ =][\\x22\\x27]?)[0-9]{2,}(?![0-9A-Za-z_])",
    "synthetic_fixture_roots": [
      "tests"
    ],
    "synthetic_declaration": "synthetic",
    "declaration_window_bytes": 2048
  },
  "placeholders": {
    "markers": [
      "CHANGEME",
      "EXAMPLE",
      "PLACEHOLDER",
      "REDACTED",
      "SYNTHETIC"
    ],
    "patterns": [
      "<[^<>\\r\\n]+>",
      "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}",
      "\\$(?:env:)?[A-Za-z_][A-Za-z0-9_]*",
      "%[A-Za-z_][A-Za-z0-9_]*%",
      "\\*+|x{3,}|X{3,}|\\.{3,}"
    ]
  }
}
